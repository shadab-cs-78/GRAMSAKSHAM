# ==========================================
# Gram Saksham MoSJE Environment Variables
# ==========================================

# 1. Google Gemini AI API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model (Defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# 2. MongoDB Connection String (Get free cloud database from https://www.mongodb.com/atlas)
# Example: mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/gramsaksham?retryWrites=true&w=majority
MONGODB_URI=

# 3. Server Port
PORT=5000
